  "type": "module",
  "description": "Dance Analytics Dashboard (DAD) frontend prototype - CS 4850 Team 2 MT-1 HCI",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
