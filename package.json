{
  "name": "dance-practice-analytics",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Dance Practice Analytics: on-device pose estimation and neutral attempt-to-attempt measurements for dance practice clips (KSU CS 4850, team MT-2-HCI)",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "clips": "node scripts/make-test-clips.mjs",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:v2": "playwright test -c playwright.v2.config.ts",
    "check:rls": "node scripts/rls-check.mjs",
    "deploy": "node scripts/deploy-vercel.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.2.3",
    "@supabase/supabase-js": "^2.119.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fake-indexeddb": "^6.2.8",
    "mp4-muxer": "^5.2.2",
    "puppeteer-core": "^25.16.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
