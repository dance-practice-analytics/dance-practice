# Copy to .env.local and save it WITHOUT a byte-order mark (BOM), or Vite drops the first variable.
# Only public client values belong in this file. Everything prefixed VITE_ ends up in the browser bundle.

# Supabase project (public values; the publishable key is safe in the browser, RLS protects data).
# Leave both empty to run the old MT-1 prototype on in-browser mock data.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# MT-1 prototype only: leave empty to use the built-in synthetic session (mock API).
VITE_DAD_API_URL=

# Server-side secrets are NOT set here and never get a VITE_ prefix. The AI provider's settings
# live only in Supabase secrets, set by the project owner in their own terminal:
#   npx supabase secrets set LLM_API_KEY=... LLM_BASE_URL=... LLM_MODEL=...
