# Supabase project (public values; the publishable key is safe in the browser, RLS protects data)
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Leave empty to use the built-in synthetic session (mock API).
VITE_DAD_API_URL=
# Server-side secrets are NOT set here. ANTHROPIC_API_KEY lives only in Supabase secrets:
#   npx supabase secrets set ANTHROPIC_API_KEY=...
